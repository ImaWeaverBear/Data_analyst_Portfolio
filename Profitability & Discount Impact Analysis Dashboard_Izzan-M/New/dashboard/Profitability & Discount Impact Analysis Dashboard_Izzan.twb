    <worksheet name='Number of Sales by Category'>
      <table>
        <view>
          <datasources>
            <datasource caption='Data Raw (Profitability &amp; Discount Impact Analysis Dashboard_Izzan)' name='federated.1qeaiim10wwfm319leyqy0ni3rv6' />
          </datasources>
          <datasource-dependencies datasource='federated.1qeaiim10wwfm319leyqy0ni3rv6'>
            <column caption='Discount Level' datatype='string' name='[Calculation_0899410895589377]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;No Discount&quot;&#13;&#10;ELSEIF [Discount] &lt;= 0.20 THEN &quot;Low Discount&quot;&#13;&#10;ELSEIF [Discount] &lt;= 0.40 THEN &quot;Medium Discount&quot;&#13;&#10;ELSE &quot;High Discount&quot;&#13;&#10;END' />
            </column>
            <column caption='Profit Status' datatype='string' name='[Calculation_0899410900348930]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Profit] &lt; 0 THEN &quot;Loss&quot;&#13;&#10;ELSEIF [Profit] = 0 THEN &quot;No Profit&quot;&#13;&#10;ELSE &quot;Profit&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
            <column datatype='real' name='[Discount]' role='measure' type='quantitative' />
            <column datatype='string' name='[Product Name]' role='dimension' type='nominal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Customer ID]' derivation='Count' name='[cnt:Customer ID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[pcto:sum:Sales:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1qeaiim10wwfm319leyqy0ni3rv6].[Action (Category)]'>
            <groupfilter function='level-members' level='[Category]' user:ui-action-filter='[Action9_448C1E994851441CBBBBB02C71F527F1]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1qeaiim10wwfm319leyqy0ni3rv6].[Action (Discount Level,Category)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action5_776B7D2E4016433C9CEBF718A9C2702D]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_0899410895589377]' />
              <groupfilter function='level-members' level='[Category]' />
