      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0pmvt0r1pbtw4415c3srg12b6wzs]&quot;' value='Total Revenue' />
          <alias key='&quot;[federated.0pmvt0r1pbtw4415c3srg12b6wzs].[sum:Calculation_2040433280335874:qk]&quot;' value='Revenue' />
        </aliases>
      </column>
      <column caption='Acquisition Cost' datatype='integer' name='[Acquisition_Cost]' role='measure' type='quantitative' />
      <column caption='CTR' datatype='real' name='[Calculation_2040433279987712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Clicks]) / SUM([Impressions])' />
      </column>
      <column caption='CPC' datatype='real' name='[Calculation_2040433280040961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Acquisition_Cost]) / SUM([Clicks])' />
      </column>
      <column caption='Revenue Generated' datatype='real' name='[Calculation_2040433280335874]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Acquisition_Cost] * (1 + [ROI])' />
      </column>
      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_2040433280417795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2040433589309444] / [Calculation_2040433280335874]' />
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_2040433589309444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2040433280335874] - [Acquisition_Cost]' />
      </column>
      <column caption='Engagement Rate' datatype='real' default-format='p0.00%' name='[Calculation_2040433589907461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Engagement_Score]) / SUM([Impressions])' />
      </column>
      <column caption='CPM' datatype='real' name='[Calculation_2040433606545414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Acquisition_Cost]) / SUM([Impressions])) *1000' />
      </column>
      <column caption='Conversion Efficiency' datatype='real' name='[Calculation_2040433606758407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Conversion_Rate])&#13;&#10;/&#13;&#10;AVG([Acquisition_Cost])' />
      </column>
      <column caption='ROI Category' datatype='string' name='[Calculation_2040433606864904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ROI] &gt;= 7 THEN &quot;High&quot;&#13;&#10;&#13;&#10;ELSEIF [ROI] &gt;= 4 THEN &quot;Medium&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='AB Test Group' datatype='string' name='[Calculation_2040433634308106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Campaign_Type] = &quot;Email&quot;&#13;&#10;&#13;&#10;THEN &quot;Group A&quot;&#13;&#10;&#13;&#10;ELSEIF [Campaign_Type] = &quot;Social Media&quot;&#13;&#10;&#13;&#10;THEN &quot;Group B&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Year' datatype='integer' name='[Calculation_2040433634365451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Date])' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_2040433634455564]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;,[Date]))' />
      </column>
      <column caption='Month Year' datatype='datetime' name='[Calculation_2040433634500621]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Date])' />
      </column>
      <column caption='Conversion' datatype='real' name='[Calculation_2040433693286414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Clicks] * [Conversion_Rate])' />
      </column>
      <column caption='Campaign ID' datatype='integer' name='[Campaign_ID]' role='dimension' type='ordinal' />
      <column caption='Campaign Type' datatype='string' name='[Campaign_Type]' role='dimension' type='nominal' />
      <column caption='Channel Used' datatype='string' name='[Channel_Used]' role='dimension' type='nominal' />
