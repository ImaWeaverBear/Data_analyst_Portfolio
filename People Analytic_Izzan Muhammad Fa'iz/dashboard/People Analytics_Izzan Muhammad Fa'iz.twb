      <aliases enabled='yes' />
      <column caption='Total Candidate' datatype='integer' name='[Calculation_1130041484210176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([enrollee_id])' />
      </column>
      <column caption='Job Change Candidate' datatype='integer' name='[Calculation_1130041484369921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([target])' />
      </column>
      <column caption='Job Change Rate' datatype='real' name='[Calculation_1130041484529666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([target]) / COUNT([enrollee_id])' />
      </column>
      <column caption='Stay Candidate' datatype='integer' name='[Calculation_1130041484648451]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-[Calculation_1130041484369921]' />
      </column>
      <column caption='Average Experience' datatype='real' name='[Calculation_1130041484890116]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([experience_num])' />
      </column>
      <column caption='Average Training Hours' datatype='real' name='[Calculation_1130041484955653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([training_hours])' />
      </column>
      <column caption='Job Status' datatype='string' name='[Calculation_2117952887873536]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [target] = 1 THEN &quot;Job Change&quot;&#13;&#10;ELSE &quot;Stay&quot;&#13;&#10;END' />
      </column>
