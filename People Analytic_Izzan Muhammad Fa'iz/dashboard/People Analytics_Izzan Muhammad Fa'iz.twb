    <worksheet name='Relevant Experience by Job Change Rate'>
      <table>
        <view>
          <datasources>
            <datasource caption='People Analytic - Data train_cleaned' name='federated.09jo1th1p7rtwl19njpf91aswisx' />
          </datasources>
          <datasource-dependencies datasource='federated.09jo1th1p7rtwl19njpf91aswisx'>
            <column caption='Job Change Rate' datatype='real' name='[Calculation_1130041484529666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([target]) / COUNT([enrollee_id])' />
            </column>
            <column caption='Job Status' datatype='string' name='[Calculation_2117952887873536]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [target] = 1 THEN &quot;Job Change&quot;&#13;&#10;ELSE &quot;Stay&quot;&#13;&#10;END' />
